# Copy this file to .env and fill in your own values. .env is gitignored — never commit it.
#
# Only PUBLIC values belong here: anything prefixed EXPO_PUBLIC_ is bundled into the app
# and can be read by anyone who has the APK.
#   - Supabase dashboard → Project Settings → API Keys
#   - Use the PUBLISHABLE key. NEVER put the secret / service_role key or the database
#     password in this file or anywhere in the app.
#
# For EAS builds these come from EAS environment variables instead (see README).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
